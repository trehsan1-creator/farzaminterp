# Farzam ERP — environment template. Never commit real values.
# Preview and production must use separate Supabase projects and credentials.

# Supabase — service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=import-source

# Legacy Muse ingestion API. Leave empty until explicitly provisioned.
MUSE_API_KEY=

# PIP Agent API. Leave AGENT_API_KEY empty until the owner provisions it
# in the deployment's secure environment settings. Never paste it into chat.
AGENT_API_KEY=
AGENT_API_KEY_ID=pip-dev
AGENT_ID=pip
AGENT_COMPANY_ID=
AGENT_API_SCOPES=tasks:read,tasks:write,audit:read

# Protects the internal expired-lease reaper endpoint.
CRON_SECRET=

# Application
NEXT_PUBLIC_APP_ENV=development
