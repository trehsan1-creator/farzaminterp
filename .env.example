# Farzam ERP — environment template.
# Copy to .env.local for development. NEVER commit real values.
# Preview and production environments must use separate Supabase projects.

# --- Supabase (server-side only values stay on the server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only. Must never be exposed to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Private storage bucket for raw source files (import pipeline) ---
SUPABASE_STORAGE_BUCKET=import-source

# --- Muse / PIP integration (versioned API, see docs/API_V1.md) ---
# No credential is created in Stage 00. Leave empty until the owner provisions one.
MUSE_API_KEY=

# --- Application ---
NEXT_PUBLIC_APP_ENV=development
